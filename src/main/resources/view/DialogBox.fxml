<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         prefWidth="460.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <Label fx:id="dialog" text="Label" wrapText="true" minHeight="-Infinity">
      <HBox.margin>
        <Insets left="7.0" right="7.0" />
      </HBox.margin>
      <padding>
        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
      </padding>
    </Label>
    <ImageView fx:id="displayPicture" fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
  </children>
  <padding>
    <Insets bottom="12.0" left="8.0" right="8.0" top="12.0" />
  </padding>
  <stylesheets>
    <URL value="@../css/dialog-box.css" />
  </stylesheets>
</fx:root>
